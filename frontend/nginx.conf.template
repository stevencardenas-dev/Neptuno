# Plantilla de nginx para Neptuno. El entrypoint de la imagen sustituye las
# variables ${...} por las variables de entorno del contenedor.
# El navegador solo habla con este origen; nginx reparte /api/* a cada servicio.

resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    # Cabeceras de seguridad básicas. Ojo: un add_header dentro de un location
    # anula los heredados del server, por eso se repiten en esos bloques.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    client_max_body_size 20m;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_vary on;
    gzip_types text/plain text/css application/json application/javascript
        application/xml image/svg+xml;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "public, max-age=0, must-revalidate";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    # --- servicio-usuarios ---
    location ^~ /api/usuarios/ {
        set $upstream ${USUARIOS_SERVICE_HOST}:${USUARIOS_SERVICE_PORT};
        proxy_pass http://$upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # nginx es la entrada del sistema: sobrescribe la cabecera con la IP real en
        # vez de anexarla ($proxy_add_x_forwarded_for), o el cliente podría inventar
        # su IP de origen en la bitácora.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # --- Rutas de la SPA ---
    location / {
        try_files $uri $uri/ /index.html;
    }
}
