# Copia este archivo a .env (que no se versiona) y cambia los valores.
# docker compose se niega a arrancar si falta alguno de los obligatorios.

# Bases de datos de servicio-usuarios y servicio-documentos (cada una en su MySQL)
DB_USUARIO=neptuno
DB_CLAVE=cambia-esta-clave
DB_CLAVE_ROOT=cambia-esta-clave-root

# Broker de eventos
RABBIT_USUARIO=neptuno
RABBIT_CLAVE=cambia-esta-clave

# Firma de los JWT (HS256): mínimo 32 caracteres. Genera uno con:
#   openssl rand -base64 48
JWT_SECRETO=

# Clave compartida para las llamadas entre microservicios (/interno/**)
CLAVE_SERVICIOS=

# Administrador inicial (solo se crea la primera vez que arranca la base vacía)
ADMIN_CORREO=admin@neptuno.gov.co
ADMIN_CLAVE=
